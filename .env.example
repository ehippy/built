# Copy to .env and fill in. See src/built/config.py for the full list of settings
# and the reasoning behind each default — these are just the ones you'll actually
# need to touch to get started.

# Required: every mutating endpoint 503s until this is set (there's no
# human-approval gate anywhere in the pipeline, so it must not be open by default).
BUILT_API_KEY=

# Optional: a GitHub personal access token, referenced by name (not value) from a
# project's deploy config (github_token_ref) — used for opening PRs and polling CI
# status. Name it whatever you like; this is just a common convention.
GH_PAT=
