#!/usr/bin/env bash
# Runs before `git push`, mirroring .github/workflows/ci.yml — the same lint and
# test steps CI would run, so a push that's going to turn CI red fails locally
# first instead. Not a guarantee: a check that only ever runs on this machine
# can't catch a bug that depends on this machine's own state differing from a
# fresh CI runner's (e.g. ambient global git config) — it catches the ordinary
# case (lint errors, real test failures), not every possible CI-vs-local gap.
#
# Enable once per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

# git runs hooks with a minimal environment, not your interactive shell — an
# activated .venv doesn't carry over, so `ruff`/`pytest` bare would silently
# resolve to whatever's on the hook's PATH (often nothing). Prefer the repo's
# own .venv if one exists, matching README's `pip install -e ".[dev]"` setup,
# and fall back to PATH for anyone managing their environment another way.
repo_root="$(git rev-parse --show-toplevel)"
if [ -x "$repo_root/.venv/bin/ruff" ]; then
  RUFF="$repo_root/.venv/bin/ruff"
  PYTEST="$repo_root/.venv/bin/pytest"
else
  RUFF="ruff"
  PYTEST="pytest"
fi

echo "pre-push: ruff check ..."
"$RUFF" check "$repo_root"

echo "pre-push: pytest ..."
( cd "$repo_root" && "$PYTEST" -q )

echo "pre-push: OK"
