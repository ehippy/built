{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "built: uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["built.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "built: bootstrap venv"
    },
    {
      "name": "built: uvicorn (--reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["built.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "preLaunchTask": "built: bootstrap venv"
    }
  ]
}
