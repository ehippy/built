{% import "macros.html.j2" as m %}
<div id="board" class="board" hx-get="/ui/projects/{{ project.id }}/board/fragment" hx-trigger="every 3s" hx-swap="outerHTML">
  {% for column, label in [("pm", "Product Manager"), ("developer", "Developer"), ("tester", "Tester"), ("deployer", "Deployer")] %}
  <div class="column">
    <div class="column-header">
      <span>{{ label }}</span>
      <span>{{ board[column]|length }}</span>
    </div>
    {% for card in board[column] %}
      {{ m.card_tile(card) }}
    {% else %}
      <div class="empty-column">No cards</div>
    {% endfor %}
  </div>
  {% endfor %}
</div>
