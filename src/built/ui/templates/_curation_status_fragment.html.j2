<div id="curation-status" class="card mb-4" hx-get="/ui/projects/{{ project.id }}/curation-status/fragment" hx-trigger="every 5s" hx-swap="outerHTML">
  <div class="card-body py-2 px-3">
    <div class="text-body-secondary text-uppercase small fw-semibold mb-1">Curation</div>
    {% for s in statuses %}
    <div class="d-flex align-items-baseline gap-2 small {% if not loop.first %}border-top pt-1 mt-1{% endif %}">
      <span class="fw-semibold">{{ s.label }}</span>
      {% if s.running %}
      <span class="spinner-border spinner-border-sm" title="Running now"></span>
      <span class="text-truncate">{{ s.current_activity or "starting…" }}</span>
      {% elif s.last_run_at %}
      <span class="text-body-secondary">{{ s.last_run_at|timeago }}{% if s.summary %} — {{ s.summary }}{% endif %}</span>
      {% else %}
      <span class="text-body-secondary">never run yet</span>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</div>
