<div id="transcript" class="transcript" hx-get="/ui/cards/{{ card.id }}/events/fragment" hx-trigger="every 2s" hx-swap="outerHTML">
  {% for event in events %}
  <div class="event type-{{ event.type }}" id="event-{{ event.seq }}" hx-preserve="true">
    <div class="event-head">
      <span>#{{ event.seq }} · {{ event.type }}</span>
      <span>{{ event.created_at|timeago }}</span>
    </div>
    {% if event.type == "llm_response" %}
      {% if event.payload.content %}<pre>{{ event.payload.content }}</pre>{% endif %}
      {% if event.payload.tool_calls %}<div class="hint">tool calls: {{ event.payload.tool_calls|join(", ") }}</div>{% endif %}
    {% elif event.type == "tool_call" and event.payload.name == "update_plan" and event.payload.arguments.steps %}
      <div class="hint"><strong>Plan updated</strong>{% if event.payload.is_error %} (error){% endif %}</div>
      <ul class="plan-list">
        {% for step in event.payload.arguments.steps %}
        <li class="plan-step plan-status-{{ step.status }}">{{ step.step }}</li>
        {% endfor %}
      </ul>
    {% elif event.type == "tool_call" and event.payload.name == "bash" %}
      <div class="hint"><strong>bash</strong>{% if event.payload.is_error %} (error){% endif %}</div>
      <pre class="bash-command">$ {{ event.payload.arguments.command }}</pre>
      <details class="collapsible">
        <summary>Output ({{ event.payload.result|length }} chars){% if event.payload.is_error %} ⚠{% endif %}</summary>
        <pre>{{ event.payload.result }}</pre>
      </details>
    {% elif event.type == "tool_call" %}
      <div class="hint"><strong>{{ event.payload.name }}</strong>{% if event.payload.is_error %} (error){% endif %}</div>
      <details class="collapsible">
        <summary>Output ({{ event.payload.result|length }} chars){% if event.payload.is_error %} ⚠{% endif %}</summary>
        <pre>{{ event.payload.result }}</pre>
      </details>
    {% elif event.type == "transition" %}
      <div class="hint">{{ event.payload.column }} &rarr; {{ event.payload.outcome }}</div>
      <pre>{{ event.payload.summary }}</pre>
      {% if event.payload.feedback %}<pre>{{ event.payload.feedback }}</pre>{% endif %}
    {% else %}
      <pre>{{ event.payload }}</pre>
    {% endif %}
  </div>
  {% else %}
  <p class="subtitle">No activity yet.</p>
  {% endfor %}
  {% if card.is_being_worked %}
  <div class="thinking"><span class="spinner"></span> Agent is working…</div>
  {% endif %}
</div>
