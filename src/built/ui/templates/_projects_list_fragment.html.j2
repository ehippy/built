<div id="projects-list" class="project-list" hx-get="/ui/projects/fragment" hx-trigger="every 3s" hx-swap="outerHTML">
  {% for row in rows %}
  {% set project = row.project %}
  {% set activity = row.activity %}
  <a class="project-card {% if activity.is_being_worked %}active-card{% endif %}" href="/ui/projects/{{ project.id }}/board">
    <div class="project-card-header">
      <strong>{{ project.name }}</strong>
      {% if activity.is_being_worked %}<span class="spinner" title="Something is actively being worked on right now"></span>{% endif %}
    </div>
    <div class="goal">{{ project.overarching_goal }}</div>
    <div class="project-stats">
      {% if activity.total == 0 %}
      <span class="hint">No cards yet</span>
      {% else %}
      {% if activity.counts.active %}<span class="badge active">{{ activity.counts.active }} active</span>{% endif %}
      {% if activity.counts.blocked %}<span class="badge blocked">{{ activity.counts.blocked }} blocked</span>{% endif %}
      {% if activity.counts.done %}<span class="badge done">{{ activity.counts.done }} done</span>{% endif %}
      {% if activity.counts.failed %}<span class="badge failed">{{ activity.counts.failed }} failed</span>{% endif %}
      {% endif %}
    </div>
    {% if activity.latest %}
    <div class="project-commentary">
      <span class="hint">{{ activity.latest.column }} &middot; {{ activity.latest.card_title }} &middot; {{ activity.latest.ended_at|timeago }}</span>
      <p>{{ activity.latest.summary|truncate(180) }}</p>
    </div>
    {% endif %}
    <div class="project-meta">{{ project.updated_at|timeago }}</div>
  </a>
  {% else %}
  <p class="subtitle">No projects yet — click "New project" above to create one.</p>
  {% endfor %}
</div>
