<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}built{% endblock %} · built</title>
  <script>
    // Runs before first paint so the page never flashes the wrong theme: applies
    // any explicit saved choice immediately. No saved choice = follow the OS via
    // Bootstrap's own data-bs-theme="auto" handling below.
    (function () {
      var saved = localStorage.getItem("built-theme");
      document.documentElement.setAttribute("data-bs-theme", saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"));
    })();
  </script>
  <link rel="icon" href="/ui/static/favicon.svg" type="image/svg+xml">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    /* Transcript event bodies (_events_fragment.html.j2) use <pre> to preserve
       formatting, but long unbroken lines (stack traces, paths, hashes) shouldn't
       force horizontal overflow of the column. */
    pre { white-space: pre-wrap; overflow-wrap: anywhere; }
  </style>
  <script src="/ui/static/htmx.min.js"></script>
</head>
<body>
  <nav class="navbar navbar-expand navbar-dark bg-dark mb-4 sticky-top">
    <div class="container-fluid">
      <a class="navbar-brand" href="/ui/projects">built</a>
      {% block breadcrumb %}{% endblock %}
      <div class="navbar-nav me-auto">
        <a class="nav-link" href="/ui/projects">Projects</a>
        <a class="nav-link" href="/ui/logs">Logs</a>
        <a class="nav-link" href="/ui/endpoint-configs">Global Defaults</a>
      </div>
      <button id="theme-toggle" class="btn btn-outline-light btn-sm" type="button" aria-label="Toggle color theme" title="Toggle light/dark theme"></button>
    </div>
  </nav>
  <main class="container-fluid px-4">
    {% block content %}{% endblock %}
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/ui/static/theme.js"></script>
</body>
</html>
