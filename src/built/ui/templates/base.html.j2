<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}built{% endblock %} · built</title>
  <script>
    // Runs before first paint so the page never flashes the wrong theme: applies
    // any explicit saved choice immediately. No saved choice = follow the OS via
    // Bootstrap's own data-bs-theme="auto" handling below.
    (function () {
      var saved = localStorage.getItem("built-theme");
      document.documentElement.setAttribute("data-bs-theme", saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"));
    })();
  </script>
  <link rel="icon" href="/ui/static/favicon.svg" type="image/svg+xml">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    /* Transcript event bodies (_events_fragment.html.j2) use <pre> to preserve
       formatting, but long unbroken lines (stack traces, paths, hashes) shouldn't
       force horizontal overflow of the column. */
    pre { white-space: pre-wrap; overflow-wrap: anywhere; }
    /* Projects nav dropdown opens on hover, not click — a nav-level menu that
       just links elsewhere doesn't need a click to commit to opening it. */
    .dropdown-hover:hover > .dropdown-menu { display: block; margin-top: 0; }
    /* CI status dot next to the breadcrumb's GitHub icon — pulses while a check
       run is still in progress, steady once it settles on pass/fail. */
    .ci-dot-pulse { animation: ci-dot-pulse 1.4s ease-in-out infinite; }
    @keyframes ci-dot-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
    /* Projects list (projects_list.html.j2) — a hover cue on an otherwise
       borderless-looking clickable card, and a clamp so one long goal or
       activity summary can't blow a card out to double the height of its
       row-mates. */
    .project-card { transition: box-shadow .15s ease, border-color .15s ease; }
    .project-card:hover { border-color: var(--bs-primary); box-shadow: 0 .25rem .75rem rgba(0, 0, 0, .15); }
    .clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  </style>
  <script src="/ui/static/htmx.min.js"></script>
</head>
<body>
  <nav class="navbar navbar-expand navbar-dark bg-dark mb-4 sticky-top">
    <div class="container-fluid">
      <a class="navbar-brand" href="/ui/projects">built</a>
      <div class="navbar-nav">
        <div class="nav-item dropdown dropdown-hover">
          <a class="nav-link dropdown-toggle" href="/ui/projects">Projects</a>
          <ul id="projects-nav-menu" class="dropdown-menu dropdown-menu-dark" hx-get="/ui/projects/nav-fragment" hx-trigger="load" hx-swap="outerHTML"></ul>
        </div>
      </div>
      {% block breadcrumb %}
      {% if project %}
      <span class="navbar-text text-white-50 px-1">/</span>
      <a class="navbar-brand py-0 fs-6" href="/ui/projects/{{ project.id }}/board">{{ project.name }}</a>
      {% set gh_url = project.repo_remote_url|github_url %}
      {% if gh_url %}
      <a class="navbar-text py-0 px-1" href="{{ gh_url }}" target="_blank" rel="noopener" title="Open on GitHub"><i class="bi bi-github"></i></a>
      <span id="ci-dot-{{ project.id }}" hx-get="/ui/projects/{{ project.id }}/ci-status" hx-trigger="load" hx-swap="outerHTML"></span>
      {% endif %}
      {% endif %}
      {% endblock %}
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/ui/logs">Logs</a>
        <a class="nav-link" href="/ui/endpoint-configs">LLMs</a>
      </div>
      <button id="theme-toggle" class="btn btn-outline-light btn-sm ms-2" type="button" aria-label="Toggle color theme" title="Toggle light/dark theme"></button>
    </div>
  </nav>
  <main class="container-fluid px-4">
    {% block content %}{% endblock %}
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/ui/static/theme.js"></script>
</body>
</html>
