{% extends "base.html.j2" %}
{% import "macros.html.j2" as m %}
{% block title %}{{ project.name }} · Board{% endblock %}
{% block content %}
<ul class="nav nav-tabs mb-4">
  <li class="nav-item"><a class="nav-link active" href="/ui/projects/{{ project.id }}/board">Board</a></li>
  <li class="nav-item"><a class="nav-link" href="/ui/projects/{{ project.id }}/settings">Settings</a></li>
  <li class="nav-item"><a class="nav-link" href="/ui/projects">&larr; All projects</a></li>
</ul>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h1>{{ project.name }} {% if project.paused_at %}<span class="fs-6">{{ m.badge("paused") }}</span>{% endif %}</h1>
    <p class="text-body-secondary">{{ project.overarching_goal }}</p>
  </div>
  <div class="d-flex gap-2">
    {% if epics %}
    <form method="post" action="/ui/projects/{{ project.id }}/current-epic">
      <select class="form-select" name="epic_card_id" onchange="this.form.submit()" title="Current epic — nudges PM/curation prompts alongside the project goal, never overrides it">
        <option value="">No current epic</option>
        {% for epic in epics %}
        <option value="{{ epic.id }}" {% if epic.id == current_epic_id %}selected{% endif %}>{{ epic.title }}</option>
        {% endfor %}
      </select>
    </form>
    {% endif %}
    {% if project.paused_at %}
    <form method="post" action="/ui/projects/{{ project.id }}/resume">
      <button class="btn btn-primary" type="submit" title="Paused since {{ project.paused_at|timeago }} — resume to let the orchestrator claim cards again">&#9654; Resume</button>
    </form>
    {% else %}
    <form method="post" action="/ui/projects/{{ project.id }}/pause">
      <button class="btn btn-outline-secondary" type="submit" title="Pause to stop the orchestrator from claiming new cards for this project">&#10074;&#10074; Pause</button>
    </form>
    {% endif %}
    <div class="dropdown">
      <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
        Curation
      </button>
      <div class="dropdown-menu p-3" style="min-width: 27rem;">
        <p class="text-body-secondary">Run a focused pass over the repo and propose cards for whatever it finds — nothing is ever edited directly, every kind only ever proposes new cards. Uncheck a kind to take it off the automatic schedule; "Run now" always works regardless.</p>
        <div class="d-flex align-items-center justify-content-between border rounded p-2 mb-2">
          <span class="small">
            {% if curation_paused_at %}Automatic curation paused since {{ curation_paused_at|timeago }}{% else %}Automatic curation is active{% endif %}
          </span>
          {% if curation_paused_at %}
          <form method="post" action="/ui/projects/{{ project.id }}/curation/resume">
            <button class="btn btn-sm btn-primary" type="submit">&#9654; Resume</button>
          </form>
          {% else %}
          <form method="post" action="/ui/projects/{{ project.id }}/curation/pause">
            <button class="btn btn-sm btn-outline-secondary" type="submit">&#10074;&#10074; Pause</button>
          </form>
          {% endif %}
        </div>
        {% for s in statuses %}
        <div class="{% if not loop.first %}border-top pt-2 mt-2{% endif %}">
          <div class="d-flex align-items-center gap-2">
            <form method="post" action="/ui/projects/{{ project.id }}/curation/kinds/{{ s.kind }}" class="form-check form-switch mb-0 flex-grow-1">
              <input class="form-check-input" type="checkbox" role="switch" id="curation-enabled-{{ s.kind }}" name="enabled" value="true" {% if s.enabled %}checked{% endif %} onchange="this.form.submit()">
              <label class="form-check-label" for="curation-enabled-{{ s.kind }}">{{ s.label }}</label>
            </form>
            <form method="post" action="/ui/projects/{{ project.id }}/curate/{{ s.kind }}">
              <button class="btn btn-sm btn-secondary" type="submit">Run now</button>
            </form>
          </div>
          <div class="small text-body-secondary ps-4 text-truncate">
            {% if not s.enabled %}off — not on the automatic schedule
            {% elif s.running %}<span class="spinner-border spinner-border-sm" title="Running now"></span> {{ s.current_activity or "starting…" }}
            {% elif s.last_run_at %}{{ s.last_run_at|timeago }}{% if s.summary %} — {{ s.summary }}{% endif %}
            {% else %}never run yet
            {% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    <div class="dropdown">
      <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
        New card
      </button>
      <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 24rem;">
        <form method="post" action="/ui/projects/{{ project.id }}/cards">
          <div class="mb-3">
            <label class="form-label" for="title">Title</label>
            <input class="form-control" type="text" id="title" name="title" required placeholder="Add a health check endpoint">
          </div>
          <div class="mb-3">
            <label class="form-label" for="raw_request">Request</label>
            <textarea class="form-control" id="raw_request" name="raw_request" required placeholder="Describe what you want built..."></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label" for="priority">Priority</label>
            <select class="form-select" id="priority" name="priority">
              <option value="high">High</option>
              <option value="normal" selected>Normal</option>
              <option value="low">Low</option>
            </select>
          </div>
          <button class="btn btn-primary" type="submit">Add to board</button>
        </form>
      </div>
    </div>
  </div>
</div>

{% include "_epics_fragment.html.j2" %}

{% include "_board_fragment.html.j2" %}
{% endblock %}
