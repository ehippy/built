{% extends "base.html.j2" %}
{% block title %}{{ project.name }} · Board{% endblock %}
{% block content %}
<div class="tabs">
  <a class="active" href="/ui/projects/{{ project.id }}/board">Board</a>
  <a href="/ui/projects/{{ project.id }}/settings">Settings</a>
  <a href="/ui/projects">&larr; All projects</a>
</div>

<div class="page-header">
  <div>
    <h1>{{ project.name }}</h1>
    <p class="subtitle">{{ project.overarching_goal }}</p>
  </div>
  <div class="page-header-actions">
    <details class="action-disclosure">
      <summary class="btn secondary">Curation</summary>
      <div class="panel">
        <p class="subtitle">Run a focused pass over the repo and propose cards for whatever it finds — nothing is ever edited directly, every kind only ever proposes new cards.</p>
        <div class="curation-actions">
          <form method="post" action="/ui/projects/{{ project.id }}/curate/bug_sweep">
            <button class="btn secondary" type="submit">Bug sweep</button>
          </form>
          <form method="post" action="/ui/projects/{{ project.id }}/curate/opportunity_brainstorm">
            <button class="btn secondary" type="submit">Opportunities</button>
          </form>
          <form method="post" action="/ui/projects/{{ project.id }}/curate/polish_review">
            <button class="btn secondary" type="submit">Polish review</button>
          </form>
          <form method="post" action="/ui/projects/{{ project.id }}/curate/agents_md">
            <button class="btn secondary" type="submit">Tend AGENTS.md</button>
          </form>
        </div>
      </div>
    </details>
    <details class="action-disclosure">
      <summary class="btn">New card</summary>
      <div class="panel">
        <form method="post" action="/ui/projects/{{ project.id }}/cards">
          <div class="field">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" required placeholder="Add a health check endpoint">
          </div>
          <div class="field">
            <label for="raw_request">Request</label>
            <textarea id="raw_request" name="raw_request" required placeholder="Describe what you want built..."></textarea>
          </div>
          <button class="btn" type="submit">Add to board</button>
        </form>
      </div>
    </details>
  </div>
</div>

{% include "_board_fragment.html.j2" %}
{% endblock %}
