{% extends "base.html.j2" %}
{% import "macros.html.j2" as m %}
{% block title %}{{ card.title }}{% endblock %}
{% block content %}
<div class="mb-3">
  <h1>{{ card.title }}</h1>
  <p class="d-flex flex-wrap align-items-center gap-1">
    {{ m.badge(card.lifecycle_state) }}
    <span class="badge text-bg-secondary">{{ card.column }}</span>
    {% if card.priority != "normal" %}{{ m.badge("priority-" ~ card.priority, card.priority ~ " priority") }}{% endif %}
    {% if card.archived_at %}{{ m.badge("paused", "archived") }}{% endif %}
    {% if card.branch_name %}· <code>{{ card.branch_name }}</code>{% endif %}
  </p>
  <p class="text-body-secondary small">Last updated {{ card.last_activity_at|timeago }}</p>
</div>

<!-- Every action this page offers lives here, in one place, instead of scattered
     next to whatever section happens to relate to it. -->
<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
  <form method="post" action="/ui/cards/{{ card.id }}/priority">
    <select class="form-select form-select-sm" name="priority" onchange="this.form.submit()">
      <option value="high" {% if card.priority == "high" %}selected{% endif %}>High priority</option>
      <option value="normal" {% if card.priority == "normal" %}selected{% endif %}>Normal priority</option>
      <option value="low" {% if card.priority == "low" %}selected{% endif %}>Low priority</option>
    </select>
  </form>

  {% if card.lifecycle_state in ("blocked", "failed") %}
  <details>
    <summary class="btn btn-primary btn-sm">Retry</summary>
    <div class="card card-body mt-2" style="min-width: 24rem;">
      <form method="post" action="/ui/cards/{{ card.id }}/retry">
        <div class="mb-3">
          <label class="form-label" for="note">Note for the next attempt (optional)</label>
          <textarea class="form-control" id="note" name="note" placeholder="e.g. rebase onto main and resolve the conflict in index.html"></textarea>
          <div class="form-text">Surfaced to whichever column runs next, then cleared — a one-shot instruction, not a standing rule.</div>
        </div>
        <button class="btn btn-primary" type="submit">Retry</button>
      </form>
      <p class="form-text mb-0">Resets the revision/deploy-attempt counters and makes the card claimable again — the one human touchpoint outside the autonomous pipeline.</p>
    </div>
  </details>
  {% elif card.lifecycle_state == "active" %}
  <details>
    <summary class="btn btn-outline-secondary btn-sm">Nudge</summary>
    <div class="card card-body mt-2" style="min-width: 24rem;">
      <form method="post" action="/ui/cards/{{ card.id }}/nudge">
        <div class="mb-3">
          <label class="form-label" for="nudge-note">Note for the agent</label>
          <textarea class="form-control" id="nudge-note" name="note" required placeholder="e.g. don't touch the payments module, that's handled elsewhere"></textarea>
          <div class="form-text">Reaches the agent within one iteration if it's actively working this card right now, or at the start of its next visit otherwise — then it's cleared. Doesn't pause or reset anything.</div>
        </div>
        <button class="btn btn-outline-secondary" type="submit">Send nudge</button>
      </form>
    </div>
  </details>
  <form method="post" action="/ui/cards/{{ card.id }}/cancel" onsubmit="return confirm('Cancel this card?');">
    <button class="btn btn-outline-danger btn-sm" type="submit">Cancel</button>
  </form>
  {% endif %}

  <details>
    <summary class="btn btn-secondary btn-sm">Edit</summary>
    <div class="card card-body mt-2" style="min-width: 24rem;">
      <form method="post" action="/ui/cards/{{ card.id }}/edit">
        <div class="mb-3">
          <label class="form-label" for="title">Title</label>
          <input class="form-control" type="text" id="title" name="title" required value="{{ card.title }}">
        </div>
        <div class="mb-3">
          <label class="form-label" for="raw_request">Request</label>
          <textarea class="form-control" id="raw_request" name="raw_request" required>{{ card.raw_request }}</textarea>
        </div>
        <button class="btn btn-primary" type="submit">Save</button>
      </form>
    </div>
  </details>

  {% if card.archived_at %}
  <form method="post" action="/ui/cards/{{ card.id }}/unarchive">
    <button class="btn btn-secondary btn-sm" type="submit">Unarchive</button>
  </form>
  {% else %}
  <form method="post" action="/ui/cards/{{ card.id }}/archive" onsubmit="return confirm('Archive this card? It will drop off the board until unarchived.');">
    <button class="btn btn-secondary btn-sm" type="submit">Archive</button>
  </form>
  {% endif %}
</div>

<div class="row g-3 mb-3">
  <div class="col-lg-8">
    <div class="card card-body h-100">
      <h2 class="h5">Request</h2>
      <div>{{ card.raw_request|markdown }}</div>

      {% if card.spec %}
      <h2 class="h5">Spec</h2>
      <div>{{ card.spec|markdown }}</div>
      <h2 class="h5">Acceptance criteria</h2>
      <ul>
        {% for c in card.acceptance_criteria %}<li>{{ c }}</li>{% endfor %}
      </ul>
      {% endif %}

      {% if card.latest_feedback %}
      <h2 class="h5">Latest Tester feedback</h2>
      <p>{{ card.latest_feedback }}</p>
      {% endif %}

      {% if card.retry_note %}
      <h2 class="h5">Pending retry note</h2>
      <p>{{ card.retry_note }}</p>
      <p class="form-text">Will be shown to the agent on its next visit, then cleared.</p>
      {% endif %}

      {% if card.pending_nudge %}
      <h2 class="h5">Pending nudge</h2>
      <p>{{ card.pending_nudge }}</p>
      <p class="form-text">Will reach the agent within one iteration if it's working now, or at the start of its next visit — then cleared.</p>
      {% endif %}

      <p class="form-text">Revision {{ card.revision_count }} · Deploy attempts {{ card.deploy_attempt_count }}</p>
      {% if card.deploy_url %}
      <p><a href="{{ card.deploy_url }}" target="_blank" rel="noopener">Deploy link &rarr;</a></p>
      {% endif %}
      {% if card.deploying_commit_sha %}
      <p class="mb-0">
        {{ m.badge("watching-ci", "watching CI") }}
        Pushed as <code>{{ card.deploying_commit_sha[:8] }}</code> {{ card.deploying_since|timeago }} —
        waiting on CI before this card closes out. Green advances it to done; red bounces it back to
        Developer with the failure.
      </p>
      {% endif %}
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card card-body h-100">
      <h2 class="h5">Column visits</h2>
      {% if visits %}
      <ul class="list-group list-group-flush">
        {% for v in visits %}
        <li class="list-group-item px-0">
          <div class="d-flex justify-content-between align-items-baseline">
            <strong>{{ v.column }} · attempt {{ v.attempt_number }}</strong>
            <span class="text-body-secondary small text-nowrap">{{ v.started_at|timeago }}</span>
          </div>
          <div class="small">{{ v.outcome or "in progress" }}</div>
          {% if v.summary %}<div class="text-body-secondary small">{{ v.summary }}</div>{% endif %}
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="text-body-secondary mb-0">This card hasn't been picked up by an agent yet.</p>
      {% endif %}
    </div>
  </div>

  {% if epic_parent or is_epic or dependencies or dependents %}
  <div class="col-lg-4">
    <div class="card card-body h-100">
      {% if epic_parent %}
      <h2 class="h5">Epic</h2>
      <p>Part of <a href="/ui/cards/{{ epic_parent.id }}">{{ epic_parent.title }}</a></p>
      {% endif %}

      {% if is_epic %}
      <h2 class="h5">Epic</h2>
      <p class="text-body-secondary small mb-1">
        {{ epic_children|selectattr("lifecycle_state", "equalto", "done")|list|length }}/{{ epic_children|length }}
        child cards done
        {% if card.lifecycle_state == "active" %}— completes automatically once every child does{% endif %}
      </p>
      <ul class="list-group list-group-flush mb-0">
        {% for child in epic_children %}
        <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
          <a href="/ui/cards/{{ child.id }}" class="text-truncate">{{ child.title }}</a>
          {{ m.badge(child.lifecycle_state) }}
        </li>
        {% endfor %}
      </ul>
      {% endif %}

      {% if dependencies %}
      <h2 class="h5 mt-3">Depends on</h2>
      <ul class="list-group list-group-flush mb-0">
        {% for dep in dependencies %}
        <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
          <a href="/ui/cards/{{ dep.id }}" class="text-truncate">{{ dep.title }}</a>
          {% if dep.lifecycle_state == "done" or dep.archived_at %}{{ m.badge("done") }}
          {% elif dep.lifecycle_state in ("blocked", "failed") %}{{ m.badge(dep.lifecycle_state) }}
          {% else %}{{ m.badge("waiting") }}
          {% endif %}
        </li>
        {% endfor %}
      </ul>
      {% endif %}

      {% if dependents %}
      <h2 class="h5 mt-3">Blocks</h2>
      <ul class="list-group list-group-flush mb-0">
        {% for dep in dependents %}
        <li class="list-group-item px-0"><a href="/ui/cards/{{ dep.id }}">{{ dep.title }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>
  {% endif %}
</div>

<div class="card card-body mb-4">
  <h2 class="h5">Transcript</h2>
  {% include "_events_fragment.html.j2" %}
</div>
{% endblock %}
