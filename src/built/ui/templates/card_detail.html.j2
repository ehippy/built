{% extends "base.html.j2" %}
{% import "macros.html.j2" as m %}
{% block title %}{{ card.title }}{% endblock %}
{% block content %}
<div class="tabs">
  <a href="/ui/projects/{{ project.id }}/board">&larr; {{ project.name }} board</a>
</div>

<div class="page-header">
  <div>
    <h1>{{ card.title }}</h1>
    <p class="subtitle">
      {{ m.badge(card.lifecycle_state) }}
      <span class="badge active" style="background:#6b6b76">{{ card.column }}</span>
      {% if card.archived_at %}<span class="badge paused">archived</span>{% endif %}
      {% if card.branch_name %}· <code>{{ card.branch_name }}</code>{% endif %}
    </p>
    <p class="hint">Last updated {{ card.updated_at|timeago }}</p>
  </div>
  <div class="page-header-actions">
    <details class="action-disclosure">
      <summary class="btn secondary">Edit</summary>
      <div class="panel">
        <form method="post" action="/ui/cards/{{ card.id }}/edit">
          <div class="field">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" required value="{{ card.title }}">
          </div>
          <div class="field">
            <label for="raw_request">Request</label>
            <textarea id="raw_request" name="raw_request" required>{{ card.raw_request }}</textarea>
          </div>
          <button class="btn" type="submit">Save</button>
        </form>
      </div>
    </details>
    {% if card.archived_at %}
    <form method="post" action="/ui/cards/{{ card.id }}/unarchive">
      <button class="btn secondary" type="submit">Unarchive</button>
    </form>
    {% else %}
    <form method="post" action="/ui/cards/{{ card.id }}/archive" onsubmit="return confirm('Archive this card? It will drop off the board until unarchived.');">
      <button class="btn secondary" type="submit">Archive</button>
    </form>
    {% endif %}
  </div>
</div>

{% if card.lifecycle_state in ("blocked", "failed") %}
<div class="panel">
  <h2>Retry</h2>
  <form method="post" action="/ui/cards/{{ card.id }}/retry">
    <div class="field">
      <label for="note">Note for the next attempt (optional)</label>
      <textarea id="note" name="note" placeholder="e.g. rebase onto main and resolve the conflict in index.html"></textarea>
      <div class="hint">Surfaced to whichever column runs next, then cleared — a one-shot instruction, not a standing rule.</div>
    </div>
    <button class="btn" type="submit">Retry</button>
  </form>
  <p class="hint">Resets the revision/deploy-attempt counters and makes the card claimable again — the one human touchpoint outside the autonomous pipeline.</p>
</div>
{% elif card.lifecycle_state == "active" %}
<div class="panel">
  <form class="inline" method="post" action="/ui/cards/{{ card.id }}/cancel" onsubmit="return confirm('Cancel this card?');">
    <button class="btn danger" type="submit">Cancel</button>
  </form>
</div>
{% endif %}

<div class="panel">
  <h2>Request</h2>
  <p>{{ card.raw_request }}</p>

  {% if card.spec %}
  <h2>Spec</h2>
  <div class="markdown-body">{{ card.spec|markdown }}</div>
  <h2>Acceptance criteria</h2>
  <ul>
    {% for c in card.acceptance_criteria %}<li>{{ c }}</li>{% endfor %}
  </ul>
  {% endif %}

  {% if card.latest_feedback %}
  <h2>Latest Tester feedback</h2>
  <p>{{ card.latest_feedback }}</p>
  {% endif %}

  {% if card.retry_note %}
  <h2>Pending retry note</h2>
  <p>{{ card.retry_note }}</p>
  <p class="hint">Will be shown to the agent on its next visit, then cleared.</p>
  {% endif %}

  <p class="hint">Revision {{ card.revision_count }} · Deploy attempts {{ card.deploy_attempt_count }}</p>
  {% if card.deploy_url %}
  <p><a href="{{ card.deploy_url }}" target="_blank" rel="noopener">Deploy link &rarr;</a></p>
  {% endif %}
</div>

<div class="panel">
  <h2>Column visits</h2>
  {% if visits %}
  <table>
    <thead><tr><th>Column</th><th>Attempt</th><th>Outcome</th><th>Summary</th><th>Started</th></tr></thead>
    <tbody>
    {% for v in visits %}
      <tr>
        <td>{{ v.column }}</td>
        <td>{{ v.attempt_number }}</td>
        <td>{{ v.outcome or "in progress" }}</td>
        <td>{{ v.summary or "" }}</td>
        <td>{{ v.started_at|timeago }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="subtitle">This card hasn't been picked up by an agent yet.</p>
  {% endif %}
</div>

<div class="panel">
  <h2>Transcript</h2>
  {% include "_events_fragment.html.j2" %}
</div>
{% endblock %}
