{% extends "base.html.j2" %}
{% block title %}{{ project.name }} · Chat{% endblock %}
{% block content %}
<ul class="nav nav-tabs mb-4">
  <li class="nav-item"><a class="nav-link" href="/ui/projects/{{ project.id }}/board">Board</a></li>
  <li class="nav-item"><a class="nav-link active" href="/ui/projects/{{ project.id }}/chat">Chat</a></li>
  <li class="nav-item"><a class="nav-link" href="/ui/projects/{{ project.id }}/settings">Settings</a></li>
</ul>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
  <div>
    <p class="text-body-secondary mb-0">Workshop ticket ideas with an LLM — it can browse the repo read-only and file or edit cards directly once you land on something concrete.</p>
  </div>
  <form method="post" action="/ui/projects/{{ project.id }}/chat/clear" onsubmit="return confirm('Clear this chat? The transcript stays in the database, but the conversation starts fresh.');">
    <button class="btn btn-outline-secondary btn-sm" type="submit"><i class="bi bi-arrow-counterclockwise"></i> Clear chat</button>
  </form>
</div>

<div id="chat-scroll" class="card card-body mb-4" style="height: min(65vh, 640px); overflow-y: auto;">
  {% include "_chat_fragment.html.j2" %}
</div>

<form method="post" action="/ui/projects/{{ project.id }}/chat/messages" class="d-flex gap-2 align-items-end">
  <div class="flex-grow-1">
    <textarea class="form-control" name="content" rows="2" required placeholder="What are we workshopping?"></textarea>
  </div>
  <button class="btn btn-primary" type="submit">Send</button>
</form>

<script>
  // The transcript scrolls inside #chat-scroll rather than the whole page — keep it
  // pinned to the bottom on load and on every htmx poll, but only while the human
  // hasn't scrolled up to read earlier messages (tracked via their own scrolling).
  (function () {
    var box = document.getElementById("chat-scroll");
    var stickToBottom = true;

    function nearBottom() {
      return box.scrollHeight - box.scrollTop - box.clientHeight < 80;
    }

    function scrollToBottom() {
      box.scrollTop = box.scrollHeight;
    }

    box.addEventListener("scroll", function () {
      stickToBottom = nearBottom();
    });
    document.body.addEventListener("htmx:afterSwap", function (evt) {
      if (evt.target.id === "chat-transcript" && stickToBottom) scrollToBottom();
    });
    scrollToBottom();
  })();
</script>
{% endblock %}
