{% set state_color = {"active": "primary", "blocked": "warning", "done": "success", "failed": "danger", "paused": "secondary", "watching-ci": "info", "priority-high": "danger", "priority-low": "secondary", "waiting": "secondary", "epic": "info"} %}

{% macro badge(state, label=none) -%}
<span class="badge text-bg-{{ state_color.get(state, "secondary") }}">{{ label or state }}</span>
{%- endmacro %}

{% macro card_tile(card) -%}
<a class="card mb-2 text-decoration-none border-{{ state_color.get(card.lifecycle_state, "secondary") }} {% if card.archived_at %}opacity-50{% endif %}" href="/ui/cards/{{ card.id }}">
  <div class="card-body py-2 px-3">
    <div class="d-flex align-items-center gap-2 fw-semibold">
      {{ card.title }}
      {% if card.is_being_worked %}
      <span class="spinner-border spinner-border-sm flex-shrink-0" role="status" title="An agent is actively working on this card">
        <span class="visually-hidden">Working…</span>
      </span>
      {% endif %}
    </div>
    <div class="text-body-secondary small d-flex flex-wrap align-items-center gap-1 mt-1">
      {% if card.priority != "normal" %}{{ badge("priority-" ~ card.priority, card.priority) }}{% endif %}
      {{ badge(card.lifecycle_state) }}
      {% if card.deploying_commit_sha %}{{ badge("watching-ci", "watching CI") }}{% endif %}
      {% if card.archived_at %}{{ badge("paused", "archived") }}{% endif %}
      {% if card.revision_count %}<span>· rev {{ card.revision_count }}</span>{% endif %}
      {% if card.deploy_attempt_count %}<span>· deploy attempt {{ card.deploy_attempt_count }}</span>{% endif %}
      {% if card.epic_parent_title %}<span>· epic: {{ card.epic_parent_title }}</span>{% endif %}
      {% if card.unmet_dependency_count %}{{ badge("waiting", "waiting on " ~ card.unmet_dependency_count) }}{% endif %}
    </div>
    {% if card.is_being_worked and card.typical_iterations %}
    {% set pct = ([(100 * card.current_iteration / card.typical_iterations)|round(0, 'floor')|int, 100]|min) %}
    {% set bar_color = "bg-danger" if pct >= 100 else ("bg-warning" if pct >= 50 else "") %}
    <div class="progress mt-1" style="height: 4px;" title="Turn {{ card.current_iteration }} — this column usually takes ~{{ card.typical_iterations }} (hard cap {{ card.max_iterations }})">
      <div class="progress-bar {{ bar_color }}" style="width: {{ pct }}%;"></div>
    </div>
    {% if card.activity_preview %}
    <div class="text-body-secondary small fst-italic text-truncate mt-1" title="{{ card.activity_preview }}">{{ card.activity_preview }}</div>
    {% endif %}
    {% endif %}
    <div class="text-body-secondary small mt-1">{{ card.last_activity_at|timeago }}</div>
  </div>
</a>
{%- endmacro %}
