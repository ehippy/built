{% extends "base.html.j2" %}
{% block title %}Projects{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h1>Projects</h1>
    <p class="text-body-secondary">Each project is a git repo plus an overarching goal — cards flow through PM &rarr; Developer &rarr; Tester &rarr; Deployer.</p>
  </div>
  <details>
    <summary class="btn btn-primary">New project</summary>
    <div class="card card-body mt-2" style="min-width: 28rem;">
      <form method="post" action="/ui/projects">
        <div class="row g-2 mb-3">
          <div class="col">
            <label class="form-label" for="name">Name</label>
            <input class="form-control" type="text" id="name" name="name" required placeholder="URL Shortener">
          </div>
          <div class="col">
            <label class="form-label" for="default_branch">Default branch</label>
            <input class="form-control" type="text" id="default_branch" name="default_branch" value="main">
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label" for="repo_remote_url">Git repo (URL or local path)</label>
          <input class="form-control" type="text" id="repo_remote_url" name="repo_remote_url" required placeholder="https://github.com/you/repo.git">
        </div>
        <div class="mb-3">
          <label class="form-label" for="overarching_goal">Overarching goal</label>
          <textarea class="form-control" id="overarching_goal" name="overarching_goal" required placeholder="Build a fast, well-tested URL shortener API."></textarea>
        </div>
        <div class="mb-3">
          <label class="form-label" for="sandbox_image">Sandbox image (optional)</label>
          <input class="form-control" type="text" id="sandbox_image" name="sandbox_image" placeholder="python:3.12-slim (default) — try node:22-slim for JS/TS">
        </div>
        <div class="mb-3">
          <label class="form-label" for="test_command">Test command</label>
          <input class="form-control" type="text" id="test_command" name="test_command" placeholder="pytest -q, npm test, ...">
          <div class="form-text">
            Run by Developer and Tester before they can hand off work — without this, submit_for_test
            and approve are blocked outright. Can also be set later from project settings.
          </div>
        </div>
        <div class="row g-2 mb-3">
          <div class="col">
            <label class="form-label" for="max_revisions">Max revisions</label>
            <input class="form-control" type="number" id="max_revisions" name="max_revisions" min="0" placeholder="3">
          </div>
          <div class="col">
            <label class="form-label" for="max_deploy_attempts">Max deploy attempts</label>
            <input class="form-control" type="number" id="max_deploy_attempts" name="max_deploy_attempts" min="0" placeholder="2">
          </div>
          <div class="col">
            <label class="form-label" for="max_iterations_per_run">Max iterations / run</label>
            <input class="form-control" type="number" id="max_iterations_per_run" name="max_iterations_per_run" min="1" placeholder="25">
          </div>
        </div>
        <button class="btn btn-primary" type="submit">Create project</button>
      </form>
    </div>
  </details>
</div>

{% include "_projects_list_fragment.html.j2" %}
{% endblock %}
